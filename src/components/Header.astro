---
import { SITE_TITLE } from "../consts";
import HeaderLink from "./HeaderLink.astro";
import HeaderDropdown  from "./HeaderDropdown.astro";
---

<header>
	<nav>
		<h2>
			<a href="/">{SITE_TITLE}</a>
		</h2>
		<div class="internal-links">
			<HeaderDropdown label="Essays"/>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<a href="https://voca.arizona.edu/" target="_blank">
				<span class="sr-only">Go to Voca</span>
				Voca ↗
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
		top: 0;
		position: sticky;
		z-index: 100;
		justify-items: flex;
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: gray;
		border-bottom-style: ridge;
	}

	@media (max-width: 720px) {
		nav a {
			padding: 3px;
			color: var(--black);
			border-bottom: 4px solid transparent;
			text-decoration: none;
		}
	}
</style>
