<script>
    document.querySelectorAll<HTMLElement>("[data-emoji]").forEach((el) => {
        el.addEventListener("click", () => {
            el.classList.remove("float");
            void el.offsetWidth;
            el.classList.add("float");
        });
    });
</script>
