---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
        <style>
            .stanza {
                margin-top: 40px;
                margin-bottom: 40px;
            }

            .poem {
                text-align: left;
            }

            .tag {
                color: #8b0015; /* voca tag color */
                font-family:
                    "Gill Sans", "Gill Sans MT", Calibri, "Trebuchet MS",
                    sans-serif;
                font-style: bold;
            }

            [data-emoji] {
                position: relative;
            }
            [data-emoji]::after {
                content: attr(data-emoji);
                position: absolute;
                left: 50%;
                opacity: 0;
                pointer-events: none;
                font-family: "Noto Color Emoji", sans-serif;
            }
            [data-emoji].float::after {
                animation: float 0.5s ease-out;
            }
            @keyframes float {
                0% {
                    opacity: 1;
                    transform: translate(-50%, 0);
                }
                100% {
                    opacity: 0;
                    transform: translate(-50%, -35px);
                }
            }
        </style>
    </head>
    <body>
        <Header />
        <main>
            <h1>Making Metapoetry</h1>
            <p>Written by Alysa Meng and Maryelizabeth Koepele</p>

            <div class="poem">
                <h2>INFORMATION IMPLICATION</h2>
                <h4>Written by Maryelizabeth Koepele</h4>
                <p>
                    <span
                        class="tag"
                        data-emoji="🏚️"
                        onclick="floatEmoji(this)"
                    >
                        Abandonment
                    </span>
                    ’s a worse{" "}
                    <span
                        class="tag"
                        data-emoji="😍"
                        onclick="floatEmoji(this)"
                    >
                        aesthetic
                    </span>{" "}
                    in{" "}
                    <span
                        class="tag"
                        data-emoji="💻"
                        onclick="floatEmoji(this)"
                    >
                        digital world
                    </span>
                    ; creeping{" "}
                    <span
                        class="tag"
                        data-emoji="🌱"
                        onclick="floatEmoji(this)"
                    >
                        plants
                    </span>{" "}
                    won’t grow
                </p>
                <p>
                    <span
                        class="tag"
                        data-emoji="👶"
                        onclick="floatEmoji(this)"
                    >
                        Babies
                    </span>{" "}
                    through cracks in broken links & anyway what{" "}
                    <span
                        class="tag"
                        data-emoji="👫"
                        onclick="floatEmoji(this)"
                    >
                        people
                    </span>{" "}
                    want is{" "}
                    <span
                        class="tag"
                        data-emoji="📸"
                        onclick="floatEmoji(this)"
                    >
                        photograph
                    </span>
                    s of rare
