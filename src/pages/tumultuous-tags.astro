  grid-area: 1 / 1;
  z-index: 1;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.essay-heading {
  background-color: white;
  padding: 10px;
  margin: 10px;
  max-width: 50%;
}

.essay-content p {
  text-align: left;
}

</style>